    comparison_data = {
        'Metric': ['Accuracy', 'F1-score (weighted)', 'Precision (weighted)', 'Recall (weighted)', 
                   'F1 Interictal', 'F1 Preictal'],
        'GAT (Ours)': [
            f"{gat_results['accuracy']:.3f} ± {gat_results['accuracy_std']:.3f}",
            f"{gat_results['f1_weighted']:.3f} ± {gat_results['f1_weighted_std']:.3f}",
            f"{gat_results['precision_weighted']:.3f}",
            f"{gat_results['recall_weighted']:.3f}",
            f"{gat_results['f1_interictal']:.3f}",
            f"{gat_results['f1_preictal']:.3f}"
        ],
        'GCN (Baseline)': [
            f"{gcn_results['accuracy']:.3f} ± {gcn_results['accuracy_std']:.3f}",
            f"{gcn_results['f1_weighted']:.3f} ± {gcn_results['f1_weighted_std']:.3f}",
            f"{gcn_results['precision_weighted']:.3f}",
            f"{gcn_results['recall_weighted']:.3f}",
            f"{gcn_results['f1_interictal']:.3f}",
            f"{gcn_results['f1_preictal']:.3f}"
        ],
        'Improvement (%)': [
            f"{(gat_results['accuracy'] - gcn_results['accuracy']) / max(gcn_results['accuracy'], 0.01) * 100:+.1f}",
            f"{(gat_results['f1_weighted'] - gcn_results['f1_weighted']) / max(gcn_results['f1_weighted'], 0.01) * 100:+.1f}",
            f"{(gat_results['precision_weighted'] - gcn_results['precision_weighted']) / max(gcn_results['precision_weighted'], 0.01) * 100:+.1f}",
            f"{(gat_results['recall_weighted'] - gcn_results['recall_weighted']) / max(gcn_results['recall_weighted'], 0.01) * 100:+.1f}",
            f"{(gat_results['f1_interictal'] - gcn_results['f1_interictal']) / max(gcn_results['f1_interictal'], 0.01) * 100:+.1f}",
            f"{(gat_results['f1_preictal'] - gcn_results['f1_preictal']) / max(gcn_results['f1_preictal'], 0.01) * 100:+.1f}"
