    df.to_csv(save_path, index=False, encoding='utf-8-sig')
    print(f" Таблица сравнения сохранена: {save_path}")
    
    return df


def compare_gat_vs_gcn(graph_dataset, channel_names_list, common_channels, device, 
                       class_weight_ratio=3.0, n_splits=5):
    """
    Проводит полное сравнение GAT vs GCN.
    """
    print("\n" + "="*70)
    print("🔬 СРАВНЕНИЕ МОДЕЛЕЙ: GAT vs GCN")
    print("="*70)
    
    # Подготовка весов классов
    labels = [g.y.item() for g in graph_dataset]
    label_counts = Counter(labels)
    class_weights = torch.tensor([1.0, class_weight_ratio], dtype=torch.float).to(device)
    
    print(f" Веса классов: Interictal=1.00, Preictal={class_weight_ratio:.1f}")
    print(f" Распределение: Interictal={label_counts[0]}, Preictal={label_counts[1]}")
    
    
    gat_cv_results, gat_mean_results = train_model_with_cv(
        GATClassifierImproved, graph_dataset, channel_names_list, common_channels,
        device, class_weights, n_splits=n_splits, max_epochs=200, model_name="GAT"
    )
    gat_mean_results['cv_results'] = gat_cv_results
    
    gcn_cv_results, gcn_mean_results = train_model_with_cv(
        GCNClassifier, graph_dataset, channel_names_list, common_channels,
        device, class_weights, n_splits=n_splits, max_epochs=200, model_name="GCN"
    )
    gcn_mean_results['cv_results'] = gcn_cv_results
    
    plot_model_comparison(gat_mean_results, gcn_mean_results, save_path='gat_vs_gcn_comparison.png')
    
    comparison_df = save_comparison_results(gat_mean_results, gcn_mean_results)
    
    print("РЕЗУЛЬТАТЫ СРАВНЕНИЯ GAT vs GCN")
    print(f" Кросс-валидация: {n_splits}-fold")
    print(f" Всего графов: {len(graph_dataset)}")
    print(f" Каналов: {len(common_channels)}")
    print("\n СРАВНЕНИЕ МЕТРИК:")
    print(f"{'Метрика':<25} {'GAT':<20} {'GCN':<20} {'Улучшение':<15}")
    print("-"*80)
    print(f"{'Accuracy':<25} {gat_mean_results['accuracy']:.3f} ± {gat_mean_results['accuracy_std']:.3f}  {gcn_mean_results['accuracy']:.3f} ± {gcn_mean_results['accuracy_std']:.3f}  {(gat_mean_results['accuracy'] - gcn_mean_results['accuracy'])*100:+.1f}%")
    print(f"{'F1-score (weighted)':<25} {gat_mean_results['f1_weighted']:.3f} ± {gat_mean_results['f1_weighted_std']:.3f}  {gcn_mean_results['f1_weighted']:.3f} ± {gcn_mean_results['f1_weighted_std']:.3f}  {(gat_mean_results['f1_weighted'] - gcn_mean_results['f1_weighted'])*100:+.1f}%")
    print(f"{'F1 Interictal':<25} {gat_mean_results['f1_interictal']:.3f}  {gcn_mean_results['f1_interictal']:.3f}  {(gat_mean_results['f1_interictal'] - gcn_mean_results['f1_interictal'])*100:+.1f}%")
    print(f"{'F1 Preictal':<25} {gat_mean_results['f1_preictal']:.3f}  {gcn_mean_results['f1_preictal']:.3f}  {(gat_mean_results['f1_preictal'] - gcn_mean_results['f1_preictal'])*100:+.1f}%")
   
    
    # === Статистическая значимость (t-test) ===
    from scipy import stats
    gat_f1s = [r['f1_weighted'] for r in gat_cv_results]
    gcn_f1s = [r['f1_weighted'] for r in gcn_cv_results]
    
    if len(gat_f1s) > 1 and len(gcn_f1s) > 1:
        t_stat, p_value = stats.ttest_ind(gat_f1s, gcn_f1s)
        print(f"\n📊 СТАТИСТИЧЕСКАЯ ПРОВЕРКА (t-test):")
        print(f"   t-statistic: {t_stat:.3f}")
        print(f"   p-value: {p_value:.4f}")
        if p_value < 0.05:
            print(f"    Различие статистически значимо (p < 0.05)")
        else:
            print(f"    Различие не статистически значимо (p >= 0.05)")
    
    print("\n💾 Результаты сохранены:")
    print("   • gat_vs_gcn_comparison.png (график)")
    print("   • gat_vs_gcn_comparison.csv (таблица)")
    
    return gat_mean_results, gcn_mean_results, comparison_df


