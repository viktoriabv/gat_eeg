def signal_to_graph_spectral(data, sfreq=256.0, fmin=1.0, fmax=45.0, coh_threshold=0.1):
    """
    Создаёт граф с 7 признаками на узел (mean, std + 5 частотных полос).
    """
    from scipy.signal import coherence, welch
    
    n_ch, n_t = data.shape

    mean_vals = np.mean(data, axis=1, keepdims=True)
    std_vals = np.std(data, axis=1, keepdims=True)
    

    bands = {
        'delta': (1, 4),
        'theta': (4, 8),
        'alpha': (8, 13),
        'beta': (13, 30),
        'gamma': (30, 45)
    }
    
    spectral_features = []
    for ch_data in data:  
        freqs, psd = welch(ch_data, fs=sfreq, nperseg=min(256, n_t), nfft=512)
        band_powers = []
        for band_name, (f_low, f_high) in bands.items():
            mask = (freqs >= f_low) & (freqs <= f_high)
            if np.any(mask):
                band_powers.append(np.mean(psd[mask]))
            else:
                band_powers.append(0.0)
        spectral_features.append(band_powers)
    
    spectral_features = np.array(spectral_features)  
    spec_mean = spectral_features.mean(axis=0)
    spec_std = spectral_features.std(axis=0) + 1e-8
    spectral_features = (spectral_features - spec_mean) / spec_std
    
 
    node_features = np.hstack([mean_vals, std_vals, spectral_features])
    x = torch.tensor(node_features, dtype=torch.float)

    nperseg = min(256, n_t)
    noverlap = nperseg // 2
    coh_matrix = np.zeros((n_ch, n_ch))
    
    for i in range(n_ch):
        for j in range(i + 1, n_ch):
            freqs, coh_vals = coherence(
                data[i], data[j],
                fs=sfreq,
                nperseg=nperseg,
                noverlap=noverlap,
                window='hann'
            )
            mask = (freqs >= fmin) & (freqs <= fmax)
            if np.any(mask):
                mean_coh = np.mean(coh_vals[mask])
                coh_matrix[i, j] = coh_matrix[j, i] = mean_coh
    
    np.fill_diagonal(coh_matrix, 0.0)
    
    edge_index = []
    edge_attr = []
    for i in range(n_ch):
        for j in range(n_ch):
            if i != j and coh_matrix[i, j] > coh_threshold:
                edge_index.append([i, j])
                edge_attr.append(coh_matrix[i, j])
    
    if edge_index:
        edge_index = torch.tensor(edge_index, dtype=torch.long).t().contiguous()
        edge_attr = torch.tensor(edge_attr, dtype=torch.float).unsqueeze(1)
    else:
        edge_index = torch.empty((2, 0), dtype=torch.long)
        edge_attr = torch.empty((0, 1), dtype=torch.float)
    
    graph = Data(x=x, edge_index=edge_index, edge_attr=edge_attr)
    return graph, coh_matrix


def augment_with_sliding_window(clean_data_list, label_list, channel_names_list, 
                                 window_size=7680, step_size=3840):
    """
    Создаёт несколько перекрывающихся окон из каждой записи (аугментация данных).
    """
    print("🔄 Аугментация данных скользящим окном...")
    
    augmented_data = []
    augmented_labels = []
    augmented_ch_names = []
    
    for i, (data, label, ch_names) in enumerate(zip(clean_data_list, label_list, channel_names_list)):
        if data.shape[1] < window_size:
            continue
        
        n_windows = max(1, (data.shape[1] - window_size) // step_size + 1)
        
        for j in range(n_windows):
            start = j * step_size
            window = data[:, start:start + window_size]
            augmented_data.append(window)
            augmented_labels.append(label)
            augmented_ch_names.append(ch_names)
    
    print(f"✅ Увеличено с {len(clean_data_list)} до {len(augmented_data)} графов "
          f"({len(augmented_data)/max(len(clean_data_list),1):.1f}x)")
    
    return augmented_data, augmented_labels, augmented_ch_names


def rebuild_graph_dataset_spectral(clean_data_list, label_list, channel_names_list, sfreq=256, coh_threshold=0.1):
    """
    Пересоздаёт весь датасет со спектральными признаками.
    """
    print("🔄 Пересоздание графов со спектральными признаками (7 признаков на узел)...")
    
    new_dataset = []
    new_labels = []
    new_ch_names = []
    
    for i, (data, label, ch_names) in enumerate(zip(clean_data_list, label_list, channel_names_list)):
        try:
            graph, _ = signal_to_graph_spectral(data, sfreq=sfreq, coh_threshold=coh_threshold)
            graph.y = torch.tensor([label], dtype=torch.long)
            
            if graph.edge_index.shape[1] > 0 and graph.num_nodes >= 2:
                new_dataset.append(graph)
                new_labels.append(label)
                new_ch_names.append(ch_names)
        except Exception as e:
            print(f"  ⚠️ Ошибка на графе {i}: {e}")
            continue
    
    label_counts = Counter(new_labels)
    print(f"✅ Создано {len(new_dataset)} графов")
    print(f"   Класс 0 (Interictal): {label_counts[0]}")
    print(f"   Класс 1 (Preictal): {label_counts[1]}")
    
    return new_dataset, new_ch_names


def plot_channel_selection_results(results, importance_map, save_path=None):
    """Строит два графика: метрики vs каналы + важность каналов."""
