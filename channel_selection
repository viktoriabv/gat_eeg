def train_epoch_balanced(model, train_loader, optimizer, device, class_weights=None):
    """Обучение с учётом весов классов."""
    model.train()
    total_loss = 0
    
    for batch in train_loader:
        batch = batch.to(device)
        optimizer.zero_grad()
        out = model(batch.x, batch.edge_index, batch.edge_attr, batch.batch)
        
        if class_weights is not None:
            loss = F.cross_entropy(out, batch.y, weight=class_weights)
        else:
            loss = F.cross_entropy(out, batch.y)
        
        loss.backward()
        optimizer.step()
        total_loss += loss.item()
    
    return total_loss / len(train_loader)


def evaluate_model(model, val_loader, device):
    """Оценка модели на валидации."""
    model.eval()
    all_preds, all_labels = [], []
    with torch.no_grad():
        for batch in val_loader:
            batch = batch.to(device)
            out = model(batch.x, batch.edge_index, batch.edge_attr, batch.batch)
            pred = out.argmax(dim=1)
            all_preds.extend(pred.cpu().numpy())
            all_labels.extend(batch.y.cpu().numpy())
    
    acc = accuracy_score(all_labels, all_preds)
    f1 = f1_score(all_labels, all_preds, average='weighted', zero_division=0)
    return acc, f1


def extract_channel_importance(model, dataset, dataset_ch_names, device, channel_universe):
    """Извлечение весов внимания для интерпретации."""
    model.eval()
    importance_sums = {ch: 0.0 for ch in channel_universe}
    importance_counts = {ch: 0 for ch in channel_universe}
    
    with torch.no_grad():
        for graph, ch_names in zip(dataset, dataset_ch_names):
            if graph.edge_index.shape[1] == 0 or graph.num_nodes < 2:
                continue
            graph = graph.to(device)
            try:
                _, att_weights = model.conv1(
                    graph.x, graph.edge_index, graph.edge_attr,
                    return_attention_weights=True
                )
                att_edge_index, alpha = att_weights
                edge_imp = alpha.mean(dim=1).cpu().numpy()
                
                local_imp = np.zeros(graph.num_nodes)
                for i, (src, dst) in enumerate(att_edge_index.cpu().numpy().T):
                    local_imp[src] += edge_imp[i]
                    local_imp[dst] += edge_imp[i]
                
                for i in range(min(len(ch_names), graph.num_nodes)):
                    ch = ch_names[i]
                    if ch in importance_sums:
                        importance_sums[ch] += local_imp[i]
                        importance_counts[ch] += 1
            except:
                continue
    
    importance_map = {
        ch: (importance_sums[ch] / importance_counts[ch] if importance_counts[ch] > 0 else 0.0)
        for ch in channel_universe
    }
    
    ranked = sorted(importance_map.items(), key=lambda x: x[1], reverse=True)
    return [ch for ch, _ in ranked], importance_map


class GATClassifierImproved(torch.nn.Module):
    """
    Улучшенная модель GAT с 7 входными признаками.
    """
    def __init__(self, in_channels=7, hidden_channels=64, out_channels=2, heads=4):
        super().__init__()
        self.conv1 = GATv2Conv(in_channels, hidden_channels, heads=heads, edge_dim=1)
        self.conv2 = GATv2Conv(hidden_channels * heads, hidden_channels, heads=2, edge_dim=1)
        
       
        self.classifier = torch.nn.Linear(hidden_channels * 2, out_channels)
        self.dropout = torch.nn.Dropout(0.2)  

    def forward(self, x, edge_index, edge_attr, batch):
        x = self.conv1(x, edge_index, edge_attr)
        x = F.elu(x)
        x = self.dropout(x)
        x = self.conv2(x, edge_index, edge_attr)
        x = F.elu(x)
        x = global_mean_pool(x, batch)
        return self.classifier(x)

def iterative_selection_common_channels(
    graph_dataset,
    dataset_channel_names,
    device,
    min_frequency=0.95,
    min_channels=5,
    max_epochs=200,      
    accuracy_threshold=0.90,
    class_weight_ratio=3.0,  
    learning_rate=0.003, 
    verbose=True
):
    """Итеративный отбор каналов с улучшенной моделью."""
    

    diagnose_dataset(graph_dataset, dataset_channel_names)
    
    if verbose:
        print(f"\n🎯 Поиск каналов, присутствующих в {min_frequency*100:.0f}% графов...")
    
    common_channels = find_common_channels(dataset_channel_names, min_frequency=min_frequency)
    
    if len(common_channels) < min_channels + 2:
        raise ValueError(f"Слишком мало общих каналов ({len(common_channels)}).")

    if verbose:
        print(f"\n🔄 Фильтрация датасета до {len(common_channels)} общих каналов...")
    
    filtered_dataset, filtered_ch_names = filter_dataset_to_common_channels(
        graph_dataset, dataset_channel_names, common_channels
    )
    
    if len(filtered_dataset) < 20:
        raise ValueError("Слишком мало графов после фильтрации!")

    labels = [g.y.item() for g in filtered_dataset]
    label_counts = Counter(labels)
    
    class_weights = None
    if len(label_counts) == 2:
        class_weights = torch.tensor([1.0, class_weight_ratio], dtype=torch.float).to(device)
        if verbose:
            print(f"\n⚖️ Веса классов: Interictal={class_weights[0].item():.2f}, Preictal={class_weights[1].item():.2f}")
            print(f"   Распределение: Interictal={label_counts[0]}, Preictal={label_counts[1]}")
    
    if verbose:
        print("\n" + "="*70)
        print("🔧 ЭТАП 1: Обучение на полном наборе общих каналов")
        print("="*70)
    
    train_ds, val_ds, train_ch, val_ch = train_test_split(
        filtered_dataset, filtered_ch_names,
        test_size=0.2, random_state=42, stratify=labels
    )
    
    train_loader = DataLoader(train_ds, batch_size=16, shuffle=True)
    val_loader = DataLoader(val_ds, batch_size=16)
    
    n_features = train_ds[0].x.shape[1]
    model = GATClassifierImproved(in_channels=n_features, hidden_channels=64, out_channels=2).to(device)
    optimizer = optim.Adam(model.parameters(), lr=learning_rate, weight_decay=1e-4)
    
    best_val_f1 = 0
    best_model_state = None
    patience = 50  
    patience_counter = 0
    
    for epoch in range(max_epochs):
        loss = train_epoch_balanced(model, train_loader, optimizer, device, class_weights)
        val_acc, val_f1 = evaluate_model(model, val_loader, device)
        
        if val_f1 > best_val_f1:
            best_val_f1 = val_f1
            best_model_state = deepcopy(model.state_dict())
            patience_counter = 0
        else:
            patience_counter += 1
        
        if verbose and (epoch + 1) % 20 == 0:
            print(f"  Epoch {epoch+1:03d}: Loss={loss:.4f}, Val Acc={val_acc:.3f}, F1={val_f1:.3f}")
        
        if patience_counter >= patience:
            if verbose:
                print(f"  ⏹️ Early stopping на эпохе {epoch+1}")
            break
    
    if best_model_state is not None:
        model.load_state_dict(best_model_state)
    
    full_acc, full_f1 = evaluate_model(model, val_loader, device)
    
    if verbose:
        print(f"\n✅ Полный набор ({len(common_channels)} каналов): Acc={full_acc:.3f}, F1={full_f1:.3f}")
        print("\n📋 Classification Report (валидация):")
        model.eval()
        all_preds, all_labels = [], []
        with torch.no_grad():
            for batch in val_loader:
                batch = batch.to(device)
                out = model(batch.x, batch.edge_index, batch.edge_attr, batch.batch)
                pred = out.argmax(dim=1)
                all_preds.extend(pred.cpu().numpy())
                all_labels.extend(batch.y.cpu().numpy())
        print(classification_report(all_labels, all_preds, target_names=['Interictal', 'Preictal'], zero_division=0))
    
    results = [{
        'n_channels': len(common_channels),
        'accuracy': full_acc,
        'f1': full_f1,
        'selected_channels': list(common_channels)
    }]
    
    if verbose:
        print("\n🔍 Извлечение весов внимания...")
    
    ranked_channels, importance_map = extract_channel_importance(
        model, val_ds, val_ch, device, common_channels
    )
    
    if verbose:
        print(f"📊 Топ-5 важных: {ranked_channels[:5]}")
        print(f"📉 Худшие 5: {ranked_channels[-5:]}")
    
    if verbose:
        print("\n" + "="*70)
        print("🔁 ЭТАП 2: Итеративный отбор")
        print("="*70)
    
    current_channels = set(common_channels)
    threshold_f1 = full_f1 * accuracy_threshold
    
    iteration = 0
    while len(current_channels) > min_channels:
        iteration += 1
        
        candidates = [ch for ch in ranked_channels if ch in current_channels]
        if len(candidates) == 0:
            break
        
        least_important = candidates[-1]
        current_channels.remove(least_important)
        selected_list = list(current_channels)
        
        if verbose:
            print(f"\n📍 Итерация {iteration}: {len(selected_list)} каналов")
            print(f"   ✂️ Удалён: {least_important}")
        
        train_filt, train_ch_filt = filter_dataset_by_channels_list(train_ds, train_ch, selected_list)
        val_filt, val_ch_filt = filter_dataset_by_channels_list(val_ds, val_ch, selected_list)
        
        if len(train_filt) < 8 or len(val_filt) < 4:
            if verbose:
                print("   ⚠️ Мало данных, стоп.")
            break
        
        train_loader = DataLoader(train_filt, batch_size=16, shuffle=True)
        val_loader = DataLoader(val_filt, batch_size=16)
        
        model = GATClassifierImproved(in_channels=n_features, hidden_channels=64, out_channels=2).to(device)
        optimizer = optim.Adam(model.parameters(), lr=learning_rate, weight_decay=1e-4)
        
        best_val_f1_iter = 0
        best_model_state_iter = None
        for epoch in range(max_epochs // 2):
            loss = train_epoch_balanced(model, train_loader, optimizer, device, class_weights)
            val_acc, val_f1 = evaluate_model(model, val_loader, device)
            if val_f1 > best_val_f1_iter:
                best_val_f1_iter = val_f1
                best_model_state_iter = deepcopy(model.state_dict())
        
        if best_model_state_iter:
            model.load_state_dict(best_model_state_iter)
        
        val_acc, val_f1 = evaluate_model(model, val_loader, device)
        
        if verbose:
            print(f"   📈 Acc={val_acc:.3f}, F1={val_f1:.3f} | Порог: {threshold_f1:.3f}")
        
        results.append({
            'n_channels': len(selected_list),
            'accuracy': val_acc,
            'f1': val_f1,
            'selected_channels': selected_list,
            'removed_channel': least_important
        })
        
        if val_f1 < threshold_f1:
            if verbose:
                print(f"   ⚠️ Ниже порога, стоп.")
            break
    
    best_result = max(results, key=lambda x: x['f1'] / max(x['n_channels'], 1))
    
    if verbose:
        print("\n" + "="*70)
        print("🏆 ИТОГ")
        print("="*70)
        print(f"✅ Лучший: {best_result['n_channels']} каналов, F1={best_result['f1']:.3f}")
        print(f"📉 Сокращение: {len(common_channels) - best_result['n_channels']} каналов "
              f"({100*(len(common_channels) - best_result['n_channels'])/len(common_channels):.1f}%)")
        print(f"🎯 Отобранные: {best_result['selected_channels']}")
    
    return results, best_result, importance_map, common_channels

