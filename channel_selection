    f1_scores = [r['f1'] for r in results]
    acc_scores = [r['accuracy'] for r in results]
    
    ax1.plot(n_channels, f1_scores, 'bo-', linewidth=2, markersize=6, label='F1-score')
    ax1.plot(n_channels, acc_scores, 'rs--', linewidth=2, markersize=6, label='Accuracy')
    
    ax1.set_xlabel('Количество каналов', fontsize=11)
    ax1.set_ylabel('Метрика качества', fontsize=11)
