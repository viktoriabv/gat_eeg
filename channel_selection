def find_common_channels(dataset_channel_names, min_frequency=0.95):
    """Находит каналы, присутствующие в заданной доле графов."""
    channel_counts = Counter(ch for ch_list in dataset_channel_names for ch in ch_list)
    n_graphs = len(dataset_channel_names)
    threshold = min_frequency * n_graphs
    common_channels = [ch for ch, count in channel_counts.items() if count >= threshold]
    
    print(f"📊 Статистика каналов:")
    print(f"   Всего уникальных каналов: {len(channel_counts)}")
    print(f"   Каналов во всех графах (100%): {sum(1 for c in channel_counts if channel_counts[c] == n_graphs)}")
    print(f"   Каналов в >= 90% графов: {sum(1 for c in channel_counts if channel_counts[c] >= 0.9 * n_graphs)}")
    print(f"   Выбрано каналов (порог {min_frequency*100:.0f}%): {len(common_channels)}")
    
    most_common = channel_counts.most_common(10)
    print(f"\n🔝 Топ-10 самых частых каналов:")
    for ch, cnt in most_common:
        print(f"   {ch}: {cnt}/{n_graphs} ({100*cnt/n_graphs:.1f}%)")
    
    return sorted(common_channels)


def filter_graph_to_common_channels(graph, graph_channel_names, common_channels):
    """Оставляет в графе только каналы из common_channels."""
    keep_indices = [i for i, ch in enumerate(graph_channel_names) if ch in common_channels]
    
    if len(keep_indices) < 2:
        return None, []
    
    old_to_new = {old_idx: new_idx for new_idx, old_idx in enumerate(keep_indices)}
    new_x = graph.x[keep_indices]
    
    edge_mask = torch.isin(graph.edge_index[0], torch.tensor(keep_indices)) & \
                torch.isin(graph.edge_index[1], torch.tensor(keep_indices))
    new_edge_index = graph.edge_index[:, edge_mask]
    
    if new_edge_index.shape[1] > 0:
        for old_idx, new_idx in old_to_new.items():
            new_edge_index[0][new_edge_index[0] == old_idx] = new_idx
            new_edge_index[1][new_edge_index[1] == old_idx] = new_idx
    
    new_edge_attr = graph.edge_attr[edge_mask] if graph.edge_attr is not None else None
    new_ch_names = [ch for ch in graph_channel_names if ch in common_channels]
    
    return Data(x=new_x, edge_index=new_edge_index, edge_attr=new_edge_attr, y=graph.y), new_ch_names


def filter_dataset_to_common_channels(dataset, dataset_channel_names, common_channels):
    """Фильтрует весь датасет, оставляя только общие каналы."""
    filtered, filtered_names = [], []
    for graph, ch_names in zip(dataset, dataset_channel_names):
        new_g, new_ch = filter_graph_to_common_channels(graph, ch_names, common_channels)
        if new_g is not None:
            filtered.append(new_g)
            filtered_names.append(new_ch)
    print(f"✅ Отфильтровано: {len(filtered)}/{len(dataset)} графов сохранено")
    return filtered, filtered_names


def filter_dataset_by_channels_list(dataset, dataset_ch_names, selected_channels):
    """Фильтрация датасета по произвольному списку каналов."""
    filtered, filtered_names = [], []
    for graph, ch_names in zip(dataset, dataset_ch_names):
        keep_idx = [i for i, ch in enumerate(ch_names) if ch in selected_channels]
        if len(keep_idx) >= 2:
            new_g = filter_graph_by_channels_simple(graph, keep_idx)
            if new_g:
                filtered.append(new_g)
                filtered_names.append([ch_names[i] for i in keep_idx])
    return filtered, filtered_names


def filter_graph_by_channels_simple(graph, keep_indices):
    """Простая фильтрация графа по индексам."""
    old_to_new = {old: new for new, old in enumerate(keep_indices)}
    new_x = graph.x[keep_indices]
    
    edge_mask = torch.isin(graph.edge_index[0], torch.tensor(keep_indices)) & \
                torch.isin(graph.edge_index[1], torch.tensor(keep_indices))
    new_edge_index = graph.edge_index[:, edge_mask]
    
    if new_edge_index.shape[1] > 0:
        for old, new in old_to_new.items():
            new_edge_index[0][new_edge_index[0] == old] = new
            new_edge_index[1][new_edge_index[1] == old] = new
    
    new_edge_attr = graph.edge_attr[edge_mask] if graph.edge_attr is not None else None
    return Data(x=new_x, edge_index=new_edge_index, edge_attr=new_edge_attr, y=graph.y)


