    best_result = max(results, key=lambda x: x['f1'] / max(x['n_channels'], 1))
    ax1.axvline(best_result['n_channels'], color='green', linestyle=':', linewidth=2, 
                label=f"{best_result['n_channels']} каналов")
    ax1.legend(fontsize=9)
    
    # График 2: Важность каналов
    ax2 = axes[1]
    sorted_imp = sorted(importance_map.items(), key=lambda x: x[1], reverse=True)
    channels = [item[0] for item in sorted_imp]
