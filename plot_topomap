class GAT7(nn.Module):
    def __init__(self, in_ch=7, hidden=64, out_ch=2, heads=4):
        super().__init__()
        self.conv1 = GATv2Conv(in_ch, hidden, heads=heads, edge_dim=1)
        self.conv2 = GATv2Conv(hidden*heads, hidden, heads=2, edge_dim=1)
        self.fc = nn.Linear(hidden*2, out_ch)
        self.drop = nn.Dropout(0.2)
    def forward(self, x, ei, ea, batch):
        x = F.elu(self.conv1(x, ei, ea))
        x = self.drop(x)
        x = F.elu(self.conv2(x, ei, ea))
        x = global_mean_pool(x, batch)
        return self.fc(x)

def train_epoch(model, loader, opt, criterion, cw=None):
    model.train(); loss_sum=0
    for b in loader:
        b = b.to(device)
        opt.zero_grad()
        out = model(b.x, b.edge_index, b.edge_attr, b.batch)
        loss = criterion(out, b.y.view(-1), weight=cw)
        loss.backward(); opt.step()
        loss_sum += loss.item()
    return loss_sum/len(loader)

def evaluate(model, loader):
    model.eval(); preds, trues = [], []
    with torch.no_grad():
        for b in loader:
            b = b.to(device)
            out = model(b.x, b.edge_index, b.edge_attr, b.batch)
            preds.extend(out.argmax(1).cpu().numpy())
            trues.extend(b.y.view(-1).cpu().numpy())
    return accuracy_score(trues, preds), f1_score(trues, preds, average='weighted', zero_division=0)

