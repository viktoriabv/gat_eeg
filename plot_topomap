def plot_circular_topomap(channels, values, ch_pos_dict, title='Внимание', 
                          cmap='RdYlBu_r', ax=None):
    """Рисует одну карту с интерполяцией до края круга."""
    valid = [(ch, ch_pos_dict.get(ch.upper())) for ch in channels]
    valid = [(ch, pos) for ch, pos in valid if pos is not None]
    if len(valid) < 4: return None
    
    ch_names = [ch for ch, _ in valid]
    ch_vals = np.array([values[channels.index(ch)] for ch in ch_names])
    coords_2d = np.array([[pos[0], pos[1]] for _, pos in valid])
    
    radii = np.sqrt(np.sum(coords_2d**2, axis=1))
    max_radius = radii.max()
    if max_radius > 0.01:
        scale = 0.42 / max_radius
        coords_2d = coords_2d * scale
    
    n_boundary = 24
    boundary_c, boundary_v = [], []
    for angle in np.linspace(0, 2*np.pi, n_boundary, endpoint=False):
        bx, by = 0.49 * np.cos(angle), 0.49 * np.sin(angle)
        dists = np.sqrt((coords_2d[:,0]-bx)**2 + (coords_2d[:,1]-by)**2)
        nearest = np.argsort(dists)[:3]
        weights = 1.0 / (dists[nearest] + 0.01); weights /= weights.sum()
        boundary_c.append([bx, by]); boundary_v.append(np.sum(ch_vals[nearest] * weights))
    
    all_c, all_v = np.vstack([coords_2d, boundary_c]), np.hstack([ch_vals, boundary_v])
    grid_x, grid_y = np.mgrid[-0.5:0.5:150j, -0.5:0.5:150j]
    grid_z = griddata(all_c, all_v, (grid_x, grid_y), method='cubic', fill_value=np.nan)
    mask = grid_x**2 + grid_y**2 <= 0.5**2
    grid_z[~mask] = np.nan
    
    norm = Normalize(vmin=ch_vals.min(), vmax=ch_vals.max())
    standalone = ax is None
    if standalone: fig, ax = plt.subplots(figsize=(6, 5.5))
    
    cf = ax.contourf(grid_x, grid_y, grid_z, levels=60, cmap=cmap, norm=norm, alpha=0.95)
    ax.add_patch(patches.Circle((0, 0), 0.5, fill=False, edgecolor='black', linewidth=2, zorder=10))
    
    if standalone:
        ax.plot([-0.52, -0.58], [0,0], 'k-', lw=3); ax.plot([0.52, 0.58], [0,0], 'k-', lw=3)
        ax.text(-0.62, 0, 'L', ha='right', va='center', fontweight='bold'); ax.text(0.62, 0, 'R', ha='left', va='center', fontweight='bold')
        ax.plot([0,0], [0.5,0.56], 'k-', lw=2); ax.text(0, 0.59, 'N', ha='center', va='bottom', fontweight='bold')
        fig.colorbar(cf, ax=ax, fraction=0.046, pad=0.04).set_label('Внимание', rotation=270, labelpad=20)

    for i, (ch, (x,y)) in enumerate(zip(ch_names, coords_2d)):
        ax.add_patch(patches.Circle((x,y), 0.015, color=cm.get_cmap(cmap)(norm(ch_vals[i])), 
                                    ec='k', lw=1.2, zorder=12))
        r = np.sqrt(x**2+y**2); dx, dy = ((x/r)*0.055, (y/r)*0.055) if r > 0.02 else (0, 0.055)
      
        ax.text(x+dx, y+dy, ch, ha='center', va='center', fontsize=6.5, fontweight='bold',
                bbox=dict(boxstyle='round,pad=0.15', facecolor='white', alpha=0.9, edgecolor='gray'), zorder=13)
        
    ax.set_xlim(-0.55, 0.55); ax.set_ylim(-0.55, 0.55); ax.set_aspect('equal'); ax.axis('off')
    ax.set_title(f'🧠 {title}', fontweight='bold', pad=10)
    if standalone: plt.tight_layout(); plt.show()
    return ax

def visualize_attention_comparison(model, graphs, ch_lists, device, save_path='gat_comparison.png'):
    """Сравнение Preictal vs Interictal + Важность признаков (Bar Chart) + Выводы."""
    preictal = [(g, c) for g, c in zip(graphs, ch_lists) if g.y.item() == 1]
    interictal = [(g, c) for g, c in zip(graphs, ch_lists) if g.y.item() == 0]
    
    def compute_attention(class_graphs, common):
        c2i = {ch: i for i, ch in enumerate(common)}
        node_sum = np.zeros((len(common), 7)); edge_sum = defaultdict(float); valid_n = 0
        for g, chs in class_graphs:
            l2c = {i: c2i[ch] for i, ch in enumerate(chs) if ch in c2i}
            if len(l2c) < len(common) * 0.8: continue
            valid_n += 1
            for loc, com in l2c.items(): node_sum[com] += g.x[loc, :7].cpu().numpy()
            ei, ea = g.edge_index.cpu().numpy(), g.edge_attr.cpu().numpy().flatten() if g.edge_attr is not None else np.ones(g.edge_index.shape[1])
            for i in range(ei.shape[1]):
                if ei[0,i] in l2c and ei[1,i] in l2c:
                    edge_sum[tuple(sorted((l2c[ei[0,i]], l2c[ei[1,i]])))] += ea[i]
        valid_n = max(valid_n, 1); node_avg = node_sum / valid_n
        ei_l, ea_l = [], []
        for (s,d), w in edge_sum.items():
            aw = w/valid_n
            if aw > 0.05: ei_l.extend([[s,d],[d,s]]); ea_l.extend([aw, aw])
        ei = torch.tensor(ei_l, dtype=torch.long).t().contiguous() if ei_l else torch.empty((2,0), dtype=torch.long)
        ea = torch.tensor(ea_l, dtype=torch.float).unsqueeze(1) if ea_l else torch.empty((0,1), dtype=torch.float)
        
        avg_g = Data(x=torch.tensor(node_avg, dtype=torch.float), edge_index=ei, edge_attr=ea)
        model.eval()
        with torch.no_grad():
            _, att = model.conv1(avg_g.x.to(device), avg_g.edge_index.to(device), avg_g.edge_attr.to(device), return_attention_weights=True)
            edge_imp = att[1].mean(dim=1).cpu().numpy()
            node_imp = np.zeros(len(common))
            for i, (s, d) in enumerate(att[0].cpu().numpy().T):
                node_imp[s] += edge_imp[i]; node_imp[d] += edge_imp[i]
        if node_imp.max() > node_imp.min(): node_imp = (node_imp - node_imp.min()) / (node_imp.max() - node_imp.min())
        return node_imp, node_avg

    all_ch = [ch for _, chs in preictal+interictal for ch in chs]
    ch_cnt = Counter(all_ch); n_total = len(preictal) + len(interictal)
    common = sorted([ch for ch, cnt in ch_cnt.items() if cnt >= 0.9 * n_total])
    print(f"🔄 Построение карт для {len(common)} каналов...")
    
    pre_imp, _ = compute_attention(preictal, common)
    inter_imp, _ = compute_attention(interictal, common)
    
    def agg(imp):
        a = {}; 
        for ch, val in zip(common, imp):
            ch_n = ch.upper()
            if '-' in ch_n: parts = [p.split('-')[0].strip() for p in ch_n.split('-')]; ch_n = '-'.join(sorted(parts))
            a[ch_n] = a.get(ch_n, 0) + val
        s_ch = sorted(a.keys()); s_val = np.array([a[c] for c in s_ch])
        return s_ch, (s_val - s_val.min())/(s_val.max()-s_val.min()) if s_val.max()>s_val.min() else s_val
    
    pre_ch, pre_f = agg(pre_imp)
    inter_ch, inter_f = agg(inter_imp)
    
    std_pos = {'FP1':[-0.04,0.08,0.02], 'FP2':[0.04,0.08,0.02], 'F7':[-0.08,0.04,0.01], 'F3':[-0.03,0.06,0.03], 'FZ':[0,0.06,0.04], 
               'F4':[0.03,0.06,0.03], 'F8':[0.08,0.04,0.01], 'T7':[-0.09,0,0], 'C3':[-0.04,0.02,0.05], 'CZ':[0,0.02,0.06], 
               'C4':[0.04,0.02,0.05], 'T8':[0.09,0,0], 'P7':[-0.08,-0.04,0.02], 'P3':[-0.03,-0.04,0.04], 'PZ':[0,-0.04,0.05], 
               'P4':[0.03,-0.04,0.04], 'P8':[0.08,-0.04,0.02], 'O1':[-0.04,-0.08,0.02], 'O2':[0.04,-0.08,0.02], 
               'FT9':[-0.085,0.06,0.01], 'FT10':[0.085,0.06,0.01], 'A1':[-0.06,-0.02,0.0], 'A2':[0.06,-0.02,0.0]}
    
    ch_pos = {}
    for ch in pre_ch:
        cu = ch.upper()
        if '-' in cu:
            parts = [p.strip() for p in cu.split('-')]
            coords = [np.array(std_pos.get(p)) for p in parts if p in std_pos]
            if len(coords)==2: ch_pos[ch] = (coords[0]+coords[1])/2
        elif cu in std_pos: ch_pos[ch] = np.array(std_pos[cu])

    fig, axes = plt.subplots(1, 3, figsize=(20, 7))
    
    plot_circular_topomap(pre_ch, pre_f, ch_pos, title='Preictal (класс 1)\n🔴 Перед приступом', cmap='RdYlBu_r', ax=axes[0])
    plot_circular_topomap(inter_ch, inter_f, ch_pos, title='Interictal (класс 0)\n🔵 Между приступами', cmap='RdYlBu_r', ax=axes[1])
    
    feat_names = ['Mean\n(Signal)', 'Std\n(Variability)', 'Delta\n(1-4 Hz)', 'Theta\n(4-8 Hz)', 
                  'Alpha\n(8-13 Hz)', 'Beta\n(13-30 Hz)', 'Gamma\n(30-45 Hz)']
    lin_layer = getattr(model.conv1, 'lin_l', None) or getattr(model.conv1, 'lin_src', None)
    if lin_layer and hasattr(lin_layer, 'weight'):
        raw_w = lin_layer.weight.detach().abs().mean(dim=0).cpu().numpy()
    else: raw_w = np.ones(7)
    
    norm_w = raw_w / raw_w.max() if raw_w.max()>1e-8 else raw_w
    
    bars = axes[2].barh(range(len(feat_names)), norm_w[::-1], 
                        color=plt.cm.viridis(np.linspace(0.2, 0.9, 7))[::-1], edgecolor='black', height=0.6)
    
    for bar, val, raw in zip(bars, norm_w[::-1], raw_w[::-1]):
        axes[2].text(bar.get_width() + 0.02, bar.get_y() + bar.get_height()/2, 
                    f'{raw:.4f}', va='center', fontsize=9, fontweight='bold')
            
    axes[2].set_yticks(range(len(feat_names)))
    axes[2].set_yticklabels(feat_names[::-1], fontsize=9)
    axes[2].set_xlabel('Нормализованный вес (Макс = 1.0)', fontsize=10)
    axes[2].set_title('📈 Важность спектральных признаков', fontsize=12, fontweight='bold', pad=10)
    axes[2].set_xlim(0, max(norm_w)*1.2 + 0.05)
    axes[2].grid(axis='x', alpha=0.3, linestyle=':')
    axes[2].spines['top'].set_visible(False); axes[2].spines['right'].set_visible(False)

    plt.tight_layout()
    plt.savefig(save_path, dpi=300, bbox_inches='tight', facecolor='white')
    plt.show()
    print(f"💾 График сохранён: {save_path}")

    timestamp = datetime.now().strftime('%Y%m%d_%H%M')
    pd.DataFrame({'channel': pre_ch, 'preictal': pre_f, 'interictal': inter_f, 'difference': pre_f - inter_f}).to_csv(f'attention_comparison_{timestamp}.csv', index=False)

    print("\n" + "🔬"*35)
    print("📋 ЗАКЛЮЧЕНИЕ: Важность признаков и зон")
    print("🔬"*35)
    
    diff = pre_f - inter_f
    print("\n🔥 Топ-5 зон с наибольшим ростом внимания перед приступом:")
    top_diff = sorted(zip(pre_ch, diff), key=lambda x: x[1], reverse=True)[:5]
    for i, (ch, val) in enumerate(top_diff, 1):
        print(f"   {i}. {ch:10s} → +{val:.4f}")

    print("\n📊 Важность признаков (абсолютные значения):")
    for n, r in zip(feat_names, raw_w[::-1]):
        print(f"   • {n.replace(chr(10), ' '):15s} : {r:.5f}")

    max_feat = feat_names[np.argmax(raw_w)].replace(chr(10), ' ')
    print(f"\n💡 КЛЮЧЕВОЙ МАРКЕР: {max_feat} имеет наибольший вес.")
    
    print("\n🧠 ИНТЕРПРЕТАЦИЯ:")
    if raw_w[2] > 0.1: print("   • Усиление дельта-ритма (1-4 Гц) указывает на локальную синхронизацию коры.")
    if raw_w[3] > 0.1: print("   • Тета-ритм (4-8 Гц) часто связан с когнитивной нагрузкой и продромальными состояниями.")
    
    print("🔬"*35)

if __name__ == "__main__":
    visualize_attention_comparison(model, graph_dataset, final_ch_names, device, save_path='gat_comparison_final.png')
    print("🎉 Конвейер завершён успешно!")
