def preprocess_edf_data(file_paths, labels):
    from mne.time_frequency import psd_array_welch
    from mne.preprocessing import ICA
    
    clean_data, clean_labels, clean_ch_names = [], [], []
    
    for fp, lbl in zip(file_paths, labels):
        try:
            raw = mne.io.read_raw_edf(fp, preload=True, verbose=False)
            bad_p = ('--', '.', 'EEG', 'ECG', 'EMG', 'EKG', 'DC')
            valid = [ch.strip() for ch in raw.ch_names 
                     if ch.strip() and not any(ch.strip().upper().startswith(p) for p in bad_p) 
                     and any(c.isalpha() for c in ch.strip())]
            valid = list(dict.fromkeys(valid))
            if len(valid) < 5: continue
            raw.pick(valid)
            
            tmin, tmax = 0, min(120, raw.times[-1])
            fname = os.path.basename(fp)
            crop_rules = {
                "chb01_04": (1450, 1570), "chb01_18": (1700, 1820), "chb02_16+": (2960, 3080),
                "chb02_19": (3340, 3460), "chb12_06": (3340, 3460), "chb04_05": (7750, 7870),
                "chb06_18": (7750, 7870), "chb04_08": (6440, 6560), "chb04_28": (3780, 3900),
                "chb06_01": (7410, 7530), "chb06_04": (270, 390), "chb06_24": (9300, 9420),
                "chb13_21": (900, 1020), "chb13_40": (500, 620), "chb18_30": (500, 620),
                "chb13_55": (400, 520), "chb20_12": (60, 180), "chb20_13": (2440, 2560),
                "chb20_68": (1350, 1470), "chb10_89": (1350, 1470), "chb10_20": (6850, 6970),
                "chb10_30": (3000, 3120), "chb12_09": (3000, 3120), "chb18_32": (1850, 1970),
                "chb18_35": (2170, 2290), "chb16_10": (2200, 2320), "chb16_14": (1800, 1920),
                "chb16_18": (1850, 1970), "chb14_06": (1850, 1970), "chb08_02": (2670, 2790),
                "chb08_05": (2850, 2970), "chb08_13": (2420, 2540), "chb08_21": (2080, 2200),
                "chb12_23": (600, 720), "chb12_28": (140, 260), "chb05_06": (410, 530),
                "chb03_03": (410, 530), "chb05_16": (2300, 2420), "chb05_17": (2450, 2570),
                "chb07_12": (4900, 5020), "chb07_13": (3280, 3400), "chb03_01": (330, 450),
                "chb03_02": (700, 820), "chb03_04": (2100, 2220), "chb09_06": (12200, 12320),
                "chb09_08": (2940, 3060), "chb09_19": (5250, 5370), "chb14_03": (1950, 2070),
                "chb14_04": (2750, 2870), "chb14_18": (1000, 1120), "chb17a_03": (2270, 2390),
                "chb17a_04": (3020, 3140), "chb17b_63": (3120, 3240)
            }
            for k, v in crop_rules.items():
                if k in fname: tmin, tmax = v; break
            if tmax > raw.times[-1]: tmax = raw.times[-1]
            raw.crop(tmin=tmin, tmax=tmax, include_tmax=False)
            
            try: raw.set_eeg_reference('average', projection=True, verbose=False)
            except: pass
            raw.filter(1.0, 45.0, fir_design='firwin', verbose=False)
            
            n_ch = len(raw.ch_names)
            ica = ICA(n_components=min(n_ch-1, 20), random_state=42, method='fastica', max_iter=500, verbose=False)
            ica.fit(raw)
            
            src = ica.get_sources(raw).get_data()
            psds, freqs = psd_array_welch(src, sfreq=raw.info['sfreq'], fmin=1, fmax=80, n_fft=1024)
            ica.exclude = [i for i, p in enumerate(psds) if p[np.argmin(np.abs(freqs-60))] > np.percentile(p, 90)]
            raw_clean = ica.apply(raw.copy())
            
            clean_data.append(raw_clean.get_data())
            clean_labels.append(lbl)
            clean_ch_names.append(raw_clean.ch_names)
        except Exception as e:
            pass
    return clean_data, clean_labels, clean_ch_names

