def signal_to_graph_spectral(data, sfreq=256.0, fmin=1.0, fmax=45.0, coh_thresh=0.1):
    n_ch, n_t = data.shape
    bands = {'delta':(1,4), 'theta':(4,8), 'alpha':(8,13), 'beta':(13,30), 'gamma':(30,45)}
    spec = []
    for ch in data:
        f, p = welch(ch, fs=sfreq, nperseg=min(256, n_t))
        spec.append([np.mean(p[(f>=lo)&(f<=hi)]) if np.any((f>=lo)&(f<=hi)) else 0.0 for lo, hi in bands.values()])
    spec = np.array(spec)
    spec = (spec - spec.mean(axis=0)) / (spec.std(axis=0) + 1e-8)
    x = torch.tensor(np.hstack([data.mean(axis=1, keepdims=True), data.std(axis=1, keepdims=True), spec]), dtype=torch.float)
    
    coh = np.zeros((n_ch, n_ch))
    nperseg = min(256, n_t)
    for i in range(n_ch):
        for j in range(i+1, n_ch):
            f, c = coherence(data[i], data[j], fs=sfreq, nperseg=nperseg, noverlap=nperseg//2)
            coh[i,j] = coh[j,i] = np.mean(c[(f>=fmin)&(f<=fmax)]) if np.any((f>=fmin)&(f<=fmax)) else 0
            
    ei, ea = [], []
    for i in range(n_ch):
        for j in range(n_ch):
            if i!=j and coh[i,j]>coh_thresh:
                ei.append([i,j]); ea.append(coh[i,j])
    ei = torch.tensor(ei, dtype=torch.long).t().contiguous() if ei else torch.empty((2,0), dtype=torch.long)
    ea = torch.tensor(ea, dtype=torch.float).unsqueeze(1) if ea else torch.empty((0,1), dtype=torch.float)
    return Data(x=x, edge_index=ei, edge_attr=ea)

def augment_and_build_graphs(data_list, labels_list, ch_names_list, win=7680, step=3840):
    aug_data, aug_lbl, aug_ch = [], [], []
    for d, l, c in zip(data_list, labels_list, ch_names_list):
        if d.shape[1] < win: continue
        n_win = max(1, (d.shape[1]-win)//step + 1)
        for i in range(n_win):
            aug_data.append(d[:, i*step:i*step+win])
            aug_lbl.append(l); aug_ch.append(c)
            
    graphs, final_l, final_c = [], [], []
    for d, l, c in zip(aug_data, aug_lbl, aug_ch):
        g = signal_to_graph_spectral(d)
        if g.edge_index.shape[1] > 0 and g.num_nodes >= 2:
            g.y = torch.tensor(l, dtype=torch.long)
            graphs.append(g)
            final_l.append(l)
            final_c.append(c)
    return graphs, final_l, final_c

