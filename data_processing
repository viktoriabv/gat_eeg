        if tmax > raw.times[-1]:
            tmax = raw.times[-1]
        raw.crop(tmin=tmin, tmax=tmax, include_tmax=False)
       
        try:
            raw.set_eeg_reference('average', projection=True, verbose=False)
        except Exception:
            pass
        raw.filter(l_freq=1.0, h_freq=45.0, fir_design='firwin', verbose=False)
        
        # === 5. ICA ===
        n_ch = len(raw.ch_names)
        n_components = min(max(1, n_ch - 1), 20)
        ica = mne.preprocessing.ICA(
            n_components=n_components,
            random_state=42,
            method='fastica',
            max_iter=500,
            verbose=False
        )
        ica.fit(raw)
        
        ica.exclude = []
        data_sources = ica.get_sources(raw).get_data()  # (n_comp, n_times)
        sfreq = raw.info['sfreq']
        psds, freqs = psd_array_welch(data_sources, sfreq=sfreq, fmin=1, fmax=80, n_fft=1024)  # расширяем до 80 Гц

        for i, psd in enumerate(psds):
            idx_60 = np.argmin(np.abs(freqs - 60))
            if idx_60 < len(psd) and psd[idx_60] > np.percentile(psd, 90):
                ica.exclude.append(i)
        
        raw_clean = ica.apply(raw.copy())
       # === Количественная оценка качества очистки ===
        from scipy.signal import butter, filtfilt

        def bandpass_filter(data, lowcut, highcut, fs, order=4):
            nyq = 0.5 * fs
            low = lowcut / nyq
            high = highcut / nyq
            b, a = butter(order, [low, high], btype='band')
            return filtfilt(b, a, data, axis=-1)

        def compute_rms(data):
            return np.sqrt(np.mean(data ** 2, axis=-1))

        # Параметры
        sfreq = raw.info['sfreq']
        data_before = raw.get_data()          # до ICA
        data_after = raw_clean.get_data()     # после ICA

        # Общий RMS
        rms_before_total = compute_rms(data_before)
        rms_after_total = compute_rms(data_after)

        # RMS в высокочастотном диапазоне (мышечные артефакты)
        data_before_hf = bandpass_filter(data_before, 20, 45, sfreq)
        data_after_hf = bandpass_filter(data_after, 20, 45, sfreq)
        rms_before_hf = compute_rms(data_before_hf)
        rms_after_hf = compute_rms(data_after_hf)

        # Среднее по всем каналам
        mean_rms_before = np.mean(rms_before_total)
        mean_rms_after = np.mean(rms_after_total)
        mean_rms_hf_before = np.mean(rms_before_hf)
        mean_rms_hf_after = np.mean(rms_after_hf)

        # Вывод
        print(f" → RMS (все): {mean_rms_before:.2e} → {mean_rms_after:.2e} "
              f"({(1 - mean_rms_after/mean_rms_before)*100:.1f}% снижения)")
        print(f" → RMS (20–45 Гц): {mean_rms_hf_before:.2e} → {mean_rms_hf_after:.2e} "
              f"({(1 - mean_rms_hf_after/mean_rms_hf_before)*100:.1f}% снижения)")
        
        # === 9. Сохранение результата ===
        data_clean, _ = raw_clean.get_data(return_times=True)
        clean_data_list.append(data_clean)
        label_list.append(label)
        channel_names_list.append(raw_clean.ch_names)
    except Exception as e:
        print(f" → Ошибка: {str(e)}")
        continue

