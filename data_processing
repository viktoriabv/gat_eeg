    try:
        # === 1. Загрузка ===
        raw = mne.io.read_raw_edf(file_path, preload=True, verbose=False)
        
        # === 2. Фильтрация ТОЛЬКО мусора ===
        bad_prefixes = ('--', '.', 'EEG', 'ECG', 'EMG', 'EKG', 'DC')
        valid_channels = []
        for ch in raw.ch_names:
            ch_clean = ch.strip()
            if not ch_clean:
                continue
            if any(ch_clean.upper().startswith(p) for p in bad_prefixes):
                continue
            # Пропускаем, если нет букв (только цифры/символы)
            if not any(c.isalpha() for c in ch_clean):
                continue
            valid_channels.append(ch_clean)
        
        # Удаление дубликатов
        seen = set()
        unique_channels = []
        for ch in valid_channels:
            if ch not in seen:
                unique_channels.append(ch)
                seen.add(ch)
        valid_channels = unique_channels
        
        if len(valid_channels) < 5:
            print(f" → Пропущено: мало каналов ({len(valid_channels)})")
            continue
        
        raw.pick(valid_channels)
        
        eeg_times = raw.times
