        elif "chb20_68" in file_path or "chb10_89" in file_path:
            tmin, tmax = 1350, 1470
        elif "chb10_20" in file_path:
            tmin, tmax = 6850, 6970
        elif "chb10_30" in file_path or "chb12_09" in file_path:
            tmin, tmax = 3000, 3120
        elif "chb18_32" in file_path:
            tmin, tmax = 1850, 1970
        elif "chb18_35" in file_path:
            tmin, tmax = 2170, 2290
        elif "chb16_10" in file_path:
            tmin, tmax = 2200, 2320
        elif "chb16_14" in file_path:
            tmin, tmax = 1800, 1920
        elif "chb16_18" in file_path or "chb14_06" in file_path:
            tmin, tmax = 1850, 1970
        elif "chb08_02" in file_path:
